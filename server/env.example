##############################
# Server / Prisma Environment
##############################

# Primary Postgres connection used by Prisma.
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kse_tools?schema=public"

# Web server configuration
PORT=4000
TEAMS_WEBHOOK_URL=""

# Microsoft Graph / Azure AD
MS_TENANT_ID=""
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""

# Acumatica
ACU_BASE_URL=""
ACU_TOKEN=""
ACU_TENANT=""

# OpenAI
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_VISION_MODEL="gpt-5.1"
OPENAI_MAX_OUTPUT_TOKENS=2000
OPENAI_DELETE_UPLOADS=true

# Google Document AI
DOC_AI_PROJECT_ID=""
DOC_AI_LOCATION=""
DOC_AI_PROCESSOR_ID=""

# Opportunity / Market data
SAM_API_KEY=""
OPP_DEFAULT_KEYWORDS="substation,renewable,data center,utility,industrial"
OPP_RSS_FEEDS="https://news.google.com/rss/search?q=Kansas%20expansion%20construction&hl=en-US&gl=US&ceid=US:en,https://www.constructionequipmentguide.com/rss/industry-news"
BLS_API_KEY=""
NREL_API_KEY="DEMO_KEY"
EIA_API_KEY="DEMO_KEY"

# Auth
JWT_SECRET="kse-dev-secret"
JWT_REFRESH_SECRET="kse-dev-refresh-secret"
JWT_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=604800
AUTH_ALLOWED_ORIGINS=""
AUTH_USERS_JSON=""
AUTH_DEMO_EMAIL="demo@kse.com"
AUTH_DEMO_PASSWORD="demo12345"
AUTH_DEMO_NAME="Demo User"
AUTH_DEMO_ROLE="standard"

