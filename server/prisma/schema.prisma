generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                 String  @id
  userId             String?
  name               String
  industry           String?
  city               String?
  state              String?
  annualPotential    Float?
  projectedValue     Float?
  entrenchment       String?
  stage              String?
  relationshipHealth String?
  nextStep           String?
  notes              String?
  lastContact        String?
  createdAt          String?
  updatedAt          String?
  stalled            Boolean? @default(false)
  ownerId            String?
  ownerName          String?
  ownerEmail         String?
  createdById        String?
  createdByName      String?
  updatedById        String?
  updatedByName      String?
  score              Int?
}

model Contact {
  id        String  @id
  userId    String?
  accountId String?
  name      String
  email     String?
  phone     String?
  role      String?
  segment   String?
  location  String?
  influence Int?
  createdAt String?
  updatedAt String?
}

model Activity {
  id             String  @id
  userId         String?
  userName       String?
  accountId      String?
  contactId      String?
  contactName    String?
  type           String?
  channel        String?
  subject        String?
  notes          String?
  tags           Json?
  nextFollowUp   String?
  outcome        String?
  sentimentScore Int?
  duration       Int?
  date           String?
  files          Json?
  aiConfidence   Float?
}

model Movement {
  id             String  @id
  userId         String?
  userName       String?
  accountId      String?
  opportunityId  String?
  context        String?
  oldStage       String?
  newStage       String?
  movementType   String?
  notes          String?
  date           String?
}

model Opportunity {
  id                      String  @id
  userId                  String?
  accountId               String?
  contactId               String?
  contactName             String?
  type                    String?
  description             String?
  notes                   String?
  value                   Float?
  status                  String?
  stage                   String?
  createdAt               String?
  updatedAt               String?
  projectName             String?
  ecdStageKey             String?
  ecdStageLabel           String?
  bidStatus               String?
  bidDueDate              String?
  budgetaryOnly           Boolean? @default(false)
  assignedEstimator       String?
  gcList                  Json?
  projectAddress          String?
  projectCity             String?
  projectState            String?
  projectLat              String?
  projectLng              String?
  projectLocationAccuracy String?
  lastStageChange         String?
}
